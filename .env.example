# ---- LLM (any LangChain provider, format "provider:model") -------------------------
# Google Gemini (free tier: get a key at https://aistudio.google.com)
LLM_MODEL=google_genai:gemini-2.5-flash
GOOGLE_API_KEY=your-gemini-key
LLM_MODEL=google_genai:gemini-2.5-flash
GUARD_MODEL=google_genai:gemini-2.5-flash-lite
LLM_REQUESTS_PER_MINUTE=8
LLM_MAX_RETRIES=5
POSTGRES_PORT=5433
GROQ_API_KEY=groq_api_key

POSTGRES_DB=helpdesk
POSTGRES_USER=helpdesk_admin
POSTGRES_PASSWORD=change-me-admin
MCP_DB_PASSWORD=change-me-readonly
POSTGRES_PORT=5433

# ---- RAG ----------------------------------------------------------------------------
EMBEDDING_BACKEND=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RAG_TOP_K=4
RAG_MIN_SCORE=0.35

# ---- Guardrails -----------------------------------------------------------------------
USE_LLM_GUARD=true
# Role mailboxes that are allowed to appear un-redacted in answers
PII_ALLOWLIST_EMAILS=hr-helpdesk@acme-corp.example,it-helpdesk@acme-corp.example,security@acme-corp.example,phishing@acme-corp.example

# ---- Ticketing (bonus) ------------------------------------------------------------------
# Leave empty to use the mock ticket store (data/tickets/tickets.jsonl).
MONDAY_API_TOKEN=
MONDAY_BOARD_ID=
